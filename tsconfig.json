{
    "compilerOptions": {
        "module": "nodenext",
        "target": "esnext",
        "rootDir": "src",
        "outDir": "dist",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": [
            "node"
        ],
        "paths": {
            "@/*": [ "./src/*" ]
        }
    },
    "include": ["src/**/*"]
}